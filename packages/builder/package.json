{
  "name": "@chiballc/form-builder",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/form-builder.umd.js",
  "module": "dist/form-builder.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/form-builder.es.js",
      "require": "./dist/form-builder.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc && vite build && cp src/index.d.ts dist/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vueuse/core": "^13.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.539.0",
    "reka-ui": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5"
  }
}
